---
import { cn } from '@lib/utils';
import { navItems } from 'src/constants';
import ThemeToggle from './ThemeToggle';
import { ContactDialog } from './Contact/ContactDialog';

// Used to highlight the current page in the navigation bar.
const pathName = `/${Astro.request.url.split('/')[3]}`;
---

<div
  class='hidden sm:block fixed h-full w-72 p-4 text-[hsl(var(--ink-soft))] skeuo-panel'
>
  <div class='flex justify-between items-center mb-4'>
    <span class='font-semibold uppercase tracking-[0.2em] text-xs text-[hsl(var(--ink-soft))]'>
      David Neuman
    </span>
    <ThemeToggle client:only='react' />
  </div>
  <div class='flex flex-col space-y-2'>
    {
      navItems.map(({ href, name, popOut, Icon }, idx) => (
        <a target={popOut ? '_blank' : '_self'} href={href}>
          <div
            class={cn(
              'cursor-pointer p-2 skeuo-nav-item',
              pathName === href && 'skeuo-nav-active',
            )}
          >
            <div class='flex justify-between'>
              <div class='flex gap-2 items-center'>
                <Icon className='w-4 h-4' />
                <span>{name}</span>
              </div>
              <span class='flex items-center justify-center text-xs h-4 w-4 p-2.5 skeuo-keycap'>
                {idx + 1}
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <div class='border border-b border-[hsl(var(--border))] my-4'></div>

  <ContactDialog openWithSlash client:only='react' />
</div>
